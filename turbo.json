{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "packages/eslint-config/**",
    "packages/prettier-config/**",
    "packages/typescript-config/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "API_PROXY_TARGET", "VITE_*"]
    }
  }
}
