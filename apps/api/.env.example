# Optional locally: the API also reads the root .env and constructs a connection
# from POSTGRES_* when DATABASE_URL is absent. Shell variables take precedence.
# If providing DATABASE_URL, URL-encode special characters in the credentials.
# DATABASE_URL=postgresql://demo:local-dev-change-me@127.0.0.1:5432/demo
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY_HOPS=0

# Production requires NODE_ENV=production, DATABASE_URL, and explicitly configured
# HTTPS AUTH_ALLOWED_ORIGINS. Expose the API through the frontend's same origin.
# Set TRUST_PROXY_HOPS only to match a controlled reverse-proxy topology.
