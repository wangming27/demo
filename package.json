{
  "name": "self-demo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.20.0 <11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "db:logs": "docker compose logs --follow postgres",
    "db:shell": "docker compose exec postgres sh -c 'exec psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:generate": "corepack pnpm --filter @repo/api db:generate",
    "db:migrate": "corepack pnpm --filter @repo/api db:migrate",
    "db:deploy": "corepack pnpm --filter @repo/api db:deploy",
    "db:studio": "corepack pnpm --filter @repo/api db:studio",
    "db:sessions:cleanup": "corepack pnpm --filter @repo/api db:sessions:cleanup",
    "test:integration": "corepack pnpm --filter @repo/api test:integration",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0 && turbo run lint",
    "lint:fix": "eslint . --fix && turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "prettier . --check && eslint . --max-warnings 0 && turbo run lint typecheck build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "corepack pnpm check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3"
  }
}
